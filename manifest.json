{
  "manifest_version": 3,
  "name": "Odoo.sh Dark Mode",
  "version": "1.2.0",
  "description": "A hand-tuned dark theme for the Odoo.sh management console (Branches, Builds, Monitor, Logs, Shell, Settings).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Odoo.sh Dark Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.odoo.sh/*",
        "https://www.odoo.sh/*",
        "https://*.odoo.com/odoo-sh/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": [
        "https://*.odoo.sh/*",
        "https://www.odoo.sh/*",
        "https://*.odoo.com/*"
      ]
    }
  ]
}
